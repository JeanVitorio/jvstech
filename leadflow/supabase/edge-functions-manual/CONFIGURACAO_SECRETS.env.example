# Cadastre estes valores em Edge Functions > Secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Opcional: use somente IDs de preço iniciados por price_.
# Não use os IDs de produto prod_ nestas três variáveis.
# Se ficarem vazias, a função localiza o preço mensal ativo em BRL pelo produto.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

LEADFLOW_APP_URL=https://jvstech.com.br
LEADFLOW_ALLOWED_ORIGINS=https://jvstech.com.br
