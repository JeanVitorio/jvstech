# Obrigatórias: cadastre em Edge Functions > Secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Opcionais quando cada produto Stripe já possui um preço padrão mensal.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

# URL pública sem barra final.
LEADFLOW_APP_URL=https://jvstech.com.br
LEADFLOW_ALLOWED_ORIGINS=https://jvstech.com.br

# Meta WhatsApp Cloud API.
# Gere uma chave aleatória de 32 bytes e informe o resultado em base64.
WHATSAPP_CREDENTIALS_KEY=
META_WEBHOOK_VERIFY_TOKEN=
